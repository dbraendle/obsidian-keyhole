{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"strict": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"isolatedModules": true,
		"importHelpers": false,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src/**/*.ts"]
}
